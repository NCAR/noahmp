}

// Fatal-error handling. Noah-MP carries no MPI/AMReX dependency: it calls
// noahmp::fatal(), and the host (ERF) installs a handler that propagates the
// failure across all ranks (e.g. amrex::Abort -> MPI_Abort). With no handler
// installed we fall back to std::abort(). See NoahmpFatal.H.
namespace noahmp {

static FatalHandler g_fatal_handler = nullptr;

void set_fatal_handler(FatalHandler handler) { g_fatal_handler = handler; }

void fatal(const char* msg) {
    if (msg && *msg) std::cerr << msg << std::endl;
    std::cerr.flush();
    if (g_fatal_handler) g_fatal_handler(msg);  // host: cross-rank propagation
    std::abort();                               // fallback / if handler returns
}

}  // namespace noahmp

// bind(C) shim so the Fortran coupling layer routes its fatal errors through the
// same host-installed handler instead of reaching for MPI itself. Fortran prints
// its own diagnostic first (write(0,*)), so no message is forwarded here.
extern "C" void NoahmpIO_fatal_c() { noahmp::fatal(nullptr); }

// Run-time ABI guard, executed once. Member count and order are identical by
// construction (both structs are generated from @NoahmpMacro:Source) and the
// C++ layout is pinned by the static_assert in NoahmpIO.H, so no runtime size or
// member-order handshake is needed. The one cross-language hazard codegen cannot
// prevent is a precision (DOUBLE_PREC) mismatch between the two separately-invoked
// compilers: the struct is all pointers, so its size is precision-invariant and
// only this value check catches it. See the "ABI guards" comment in NoahmpIO.H.
void NoahmpIO_AssertAbi() {
    static const bool ok = []() -> bool {
        const std::size_t fortran_real_size = NoahmpRealSize_fi();
        if (fortran_real_size != sizeof(noahmp_real)) {
            std::cerr << "NoahmpIO precision mismatch: Fortran coupling real is "
                      << fortran_real_size << " bytes but C++ noahmp_real is "
                      << sizeof(noahmp_real) << " bytes. DOUBLE_PREC must be "
                         "defined (or undefined) consistently for BOTH the "
                         "Fortran and C++ compiles of the Noah-MP ERF driver."
                      << std::endl;
            noahmp::fatal(nullptr);
        }
        return true;
    }();
    (void)ok;
}

void NoahmpIO_type::ScalarInitDefault() {
     NoahmpIOScalarInitDefault_fi(&fptr);
};


void NoahmpIO_type::InitMain() {
     NoahmpInitMain_fi(&fptr);
};

void NoahmpIO_type::ReadNamelist() {
     NoahmpReadNamelist_fi(&fptr);
};

void NoahmpIO_type::ReadTable() {
     NoahmpReadTable_fi(&fptr);
};

void NoahmpIO_type::ReadLandHeader() {
     NoahmpReadLandHeader_fi(&fptr);
};

void NoahmpIO_type::ReadLandMain() {
     NoahmpReadLandMain_fi(&fptr);
